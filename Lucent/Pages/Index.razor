@page "/"

<div class="jumbotron">
    <h1 class="display-4">CADCAM Work Management System</h1>
    <p class="lead">Professional dental lab work management for SOLIDEX, 3D PRINT, and ZEST cases</p>
    <hr class="my-4">
    <p>Manage your dental cases efficiently with our comprehensive work management system. Track cases, monitor progress, and streamline your workflow.</p>
    <p class="lead">
        <a class="btn btn-primary btn-lg" href="/dashboard" role="button">Go to Dashboard</a>
        <a class="btn btn-success btn-lg ml-2" href="/cases/create" role="button">Create New Case</a>
    </p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card text-center mb-3">
            <div class="card-body">
                <div style="font-size: 3rem; color: #007bff;">
                    <span class="oi oi-layers"></span>
                </div>
                <h5 class="card-title">SOLIDEX</h5>
                <p class="card-text">Manage general dental prosthetic work including crowns, bridges, and more.</p>
                <a href="/cases?workType=SOLIDEX" class="btn btn-primary">View SOLIDEX Cases</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center mb-3">
            <div class="card-body">
                <div style="font-size: 3rem; color: #6f42c1;">
                    <span class="oi oi-print"></span>
                </div>
                <h5 class="card-title">3D PRINT</h5>
                <p class="card-text">Track 3D printing related work including surgical guides and models.</p>
                <a href="/cases?workType=PRINT3D" class="btn btn-primary">View 3D PRINT Cases</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center mb-3">
            <div class="card-body">
                <div style="font-size: 3rem; color: #fd7e14;">
                    <span class="oi oi-wrench"></span>
                </div>
                <h5 class="card-title">ZEST</h5>
                <p class="card-text">Handle Co-Cr alloy related work with specialized ZEST management.</p>
                <a href="/cases?workType=ZEST" class="btn btn-primary">View ZEST Cases</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <h3>Key Features</h3>
        <ul class="list-group">
            <li class="list-group-item">
                <strong>Case Management:</strong> Create, track, and manage dental cases across all work types
            </li>
            <li class="list-group-item">
                <strong>Dashboard Analytics:</strong> View statistics and charts with limited data points (prevents infinite chart length)
            </li>
            <li class="list-group-item">
                <strong>Search & Filter:</strong> Quickly find cases by patient name, case number, status, or work type
            </li>
            <li class="list-group-item">
                <strong>Pagination:</strong> Efficiently browse through large case lists with configurable page sizes
            </li>
            <li class="list-group-item">
                <strong>Multi-Location Support:</strong> Track cases across HV, NYC, and transfer locations
            </li>
        </ul>
    </div>
</div>
